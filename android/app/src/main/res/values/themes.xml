<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EchOS" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ech_bg</item>
        <item name="android:statusBarColor">@color/ech_topbar</item>
        <item name="android:navigationBarColor">@color/ech_bg</item>
        <item name="colorPrimary">@color/ech_green</item>
        <item name="colorPrimaryVariant">@color/ech_green_bg</item>
        <item name="colorOnPrimary">@color/ech_bg</item>
        <item name="android:colorAccent">@color/ech_green</item>
        <item name="android:textColorPrimary">@color/ech_text</item>
        <item name="android:textColorSecondary">@color/ech_sub</item>
        <item name="android:colorBackground">@color/ech_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:dialogTheme">@style/Theme.EchOS.Dialog</item>
    </style>

    <!-- 对话框主题：深色 + 入场/退场动画 -->
    <style name="Theme.EchOS.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:windowEnterAnimation">@anim/ech_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/ech_dialog_exit</item>
        <item name="android:colorAccent">@color/ech_green</item>
    </style>
</resources>
